# Merge this server block's proxy settings into the existing HTTPS site for
# nextgamecrush.site. Keep the site's current ssl_certificate,
# ssl_certificate_key, Certbot comments, and HTTP-to-HTTPS redirect unchanged.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name nextgamecrush.site;

    # Keep the existing TLS certificate directives here.

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
