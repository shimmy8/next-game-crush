# Copy to .env and fill in the empty values before running make dev.
# These URLs are for commands run on the host. Compose sets container service URLs.
APP_BASE_URL=http://localhost:8080
HTTP_ADDR=:8080
# Parallel PostgreSQL queue workers. Valid range: 1-64.
WORKER_CONCURRENCY=10
# Public read-only access to the allowlisted owner's saved profile.
DEMO_MODE_ENABLED=0
# Optional Steam catalog discovery. Defaults stay disabled until rollout.
CATALOG_DISCOVERY_ENABLED=0
# Five-field cron and IANA timezone; release-window dates always use UTC.
CATALOG_REFRESH_CRON="0 3 * * *"
CATALOG_REFRESH_TIMEZONE=Europe/Moscow
CATALOG_RECONCILIATION_CRON="0 4 * * 0"
# Bounds: lookback/horizon 1-366 days; independent budgets 1-100000/hour.
CATALOG_LOOKBACK_DAYS=30
CATALOG_HORIZON_DAYS=30
CATALOG_APPDETAILS_HOURLY_BUDGET=1000
CATALOG_AI_HOURLY_BUDGET=100
# Catalog concurrency 1-16; page size 1-200; pages 1-1000; new AppIDs 1-100000.
CATALOG_WORKER_CONCURRENCY=4
CATALOG_SEARCH_PAGE_SIZE=100
CATALOG_SEARCH_MAX_PAGES_PER_FEED=100
CATALOG_SEARCH_MAX_NEW_APPS_PER_RUN=20000
# Temporary legacy-coordinator settings, removed after search cutover.
# Cadence 1-24 hours; budget 1-1000/hour; freshness 1-730 days; page size 1-200.
CATALOG_DISCOVERY_INTERVAL_HOURS=1
CATALOG_DISCOVERY_HOURLY_BUDGET=200
CATALOG_DISCOVERY_UNKNOWN_FRESHNESS_DAYS=180
CATALOG_DISCOVERY_PAGE_SIZE=100
ALLOWED_STEAM_ID=
STEAM_WEB_API_KEY=
# Optional: leave empty to run without AI enrichment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgres://next_game_crush:next_game_crush@localhost:5432/next_game_crush?sslmode=disable
# Disposable test service, started and checked by make wait-test-db.
TEST_DATABASE_URL=postgres://next_game_crush_test:next_game_crush_test@localhost:55432/next_game_crush_test?sslmode=disable
SMTP_URL=smtp://localhost:1025
EMAIL_ACTION_SECRET=
SESSION_SECRET=

# Browser fixture authentication and local upstream overrides are fail-closed.
# Never enable these in a real-account run. `make verify` supplies them itself.
TEST_HARNESS_MODE=0
FIXTURE_AUTH_ENABLED=0
# Test harness only; normally use https://partner.steam-api.com.
STEAM_STORE_SERVICE_BASE_URL=
